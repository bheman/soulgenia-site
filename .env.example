# Database
DATABASE_URL=
DATABASE_SSL=false

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@seudominio.com.br
RESEND_NOTIFY_EMAIL=ops@example.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics (PostHog)
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Analytics (Meta Pixel)
NEXT_PUBLIC_META_PIXEL_ID=

# App URL (used for OG meta tags and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production target:
# NEXT_PUBLIC_APP_URL=https://soulgenia.com.br

# Public WhatsApp CTA. Leave empty to route CTAs to /trial while the number is not defined.
NEXT_PUBLIC_WHATSAPP_URL=
# Example:
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5548999998888?text=Oi%2C%20quero%20testar%20a%20Auria%20no%20meu%20WhatsApp.

# Node environment
NODE_ENV=development
